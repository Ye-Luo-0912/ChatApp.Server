<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Repository-scoped cache prevents an older same-version internal package in the
         machine-wide cache from bypassing packages.lock.json content-hash validation. -->
    <add key="globalPackagesFolder" value="./.nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="repository-packages" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="repository-packages">
      <package pattern="ChatApp.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
