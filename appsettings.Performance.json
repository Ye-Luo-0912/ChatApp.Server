{
  "RateLimiting": {
    "AuthLoginPermitLimit": 10000,
    "AuthLoginWindowSeconds": 60,
    "AuthRefreshPermitLimit": 10000,
    "AuthRefreshWindowSeconds": 60,
    "AuthEmailPermitLimit": 1000,
    "AuthEmailWindowSeconds": 60,
    "UserEmailChangePermitLimit": 1000,
    "UserEmailChangeWindowSeconds": 60
  },
  "PasswordHashing": {
    "MaxConcurrentOperations": 8,
    "AcquireTimeoutMilliseconds": 500
  },
  "NotificationOutbox": {
    "BatchSize": 50,
    "MaxConcurrency": 8,
    "PollIntervalSeconds": 2,
    "BacklogSampleSeconds": 15
  },
  "AvatarStorage": {
    "ReencodeMaxConcurrency": 4,
    "ReencodeAcquireTimeoutMilliseconds": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
