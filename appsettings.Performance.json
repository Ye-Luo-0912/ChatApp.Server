{
  "RateLimiting": {
    "AuthLoginPermitLimit": 10000,
    "AuthLoginWindowSeconds": 60,
    "AuthRefreshPermitLimit": 10000,
    "AuthRefreshWindowSeconds": 60,
    "AuthEmailPermitLimit": 1000,
    "AuthEmailWindowSeconds": 60,
    "UserEmailChangePermitLimit": 1000,
    "UserEmailChangeWindowSeconds": 60
  },
  "PasswordHashing": {
    "MaxConcurrentOperations": 8,
    "AcquireTimeoutMilliseconds": 500
  },
  "NotificationOutbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2,
    "BacklogSampleSeconds": 15
  },
  "LoginRisk": {
    "Enabled": false
  },
  "GeoLocation": {
    "AllowExternalFallback": false
  },
  "RuntimeHealthMetrics": {
    "RedisPingEnabled": false
  },
  "WorkerConcurrency": {
    "GlobalMaxConcurrency": 32,
    "NotificationDispatch": 8,
    "EmailDispatch": 8,
    "AttachmentScan": 4,
    "AttachmentProjection": 8,
    "AttachmentConfirm": 4,
    "AttachmentBlobDelete": 4,
    "AccountDeletion": 2,
    "AccountDeletionMaxAttempts": 5,
    "ModerationRevocation": 4,
    "DataExport": 4,
    "LoginRiskAnalysis": 2,
    "SecurityAudit": 1,
    "SecurityRevocation": 2
  },
  "AvatarStorage": {
    "ReencodeMaxConcurrency": 4,
    "ReencodeAcquireTimeoutMilliseconds": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
