<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwExceptions="false">

  <!-- 全局路径变量 -->
  <variable name="logRoot" value="${basedir}/Logs" />
  <variable name="monthFolder" value="${date:format=yyyy-MM}" />
  
  <targets async="true">
    <!-- 调试日志（完整日志） -->
    <target name="debugAll" xsi:type="File"
            fileName="${logRoot}/${monthFolder}/Debug/all_${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${exception:format=ToString}"
            archiveEvery="Day"
            maxArchiveFiles="3"
            concurrentWrites="true" />

    <!-- 错误日志（即时写入） -->
    <target name="errorLog" xsi:type="File"
            fileName="${logRoot}/${monthFolder}/Error/error_${shortdate}.log"
            layout="${longdate}|${logger}|${message}${exception:format=ToString}"
            archiveAboveSize="1073741824"
            maxArchiveFiles="60"
            keepFileOpen="true" />

    <!-- 警告日志（异步缓冲） -->
    <target name="warnLog" xsi:type="AsyncWrapper" queueLimit="5000">
      <target xsi:type="File"
              fileName="${logRoot}/${monthFolder}/Warn/warn_${shortdate}.log"
              layout="${longdate}|${logger}|${message}"
              archiveAboveSize="536870912"
              maxArchiveFiles="30" />
    </target>

    <!-- 信息日志（异步+缓冲） -->
    <target name="infoLog" xsi:type="AsyncWrapper" queueLimit="10000" overflowAction="Discard">
      <target xsi:type="BufferingWrapper" bufferSize="1000" flushTimeout="2000">
        <target xsi:type="File"
                fileName="${logRoot}/${monthFolder}/Info/info_${shortdate}.log"
                layout="${longdate}|${logger}|${message}"
                archiveAboveSize="2147483648" 
                maxArchiveFiles="90" />
      </target>
    </target>

    <!-- 控制台输出（开发环境） -->
    <target name="console" xsi:type="ColoredConsole" layout="${time}|${level:uppercase=true}|${message}" useDefaultRowHighlightingRules="false">
      <highlight-row condition="level >= LogLevel.Error" foregroundColor="Red"/>
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow"/>
    </target>
  </targets>

  <rules>
    <!-- 开发环境：记录所有级别日志 -->
    <logger name="*" minlevel="Debug" writeTo="debugAll" condition="'${environment:variable=ASPNETCORE_ENVIRONMENT}' == 'Development'" />

    <!-- 生产环境日志规则 -->
    <logger name="*" minlevel="Error" writeTo="errorLog" final="true" />
    <logger name="*" minlevel="Warn" writeTo="warnLog" final="true" />
    <logger name="*" minlevel="Info" writeTo="infoLog" />

    <!-- 控制台输出规则 -->
    <logger name="*" minlevel="Info" writeTo="console" condition="'${environment:variable=ASPNETCORE_ENVIRONMENT}' == 'Development'" />
  </rules>
</nlog>