<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogToConsole="true"
      throwExceptions="false">

  <!--
    stdout is the production durability boundary. Container/platform logging or
    OTLP is responsible for transport and retention; the application does not
    require a writable Logs directory.
  -->
  <targets async="true">
    <target name="console" xsi:type="Console">
      <layout xsi:type="JsonLayout"
              includeEventProperties="true"
              suppressSpaces="true">
        <attribute name="timestamp" layout="${date:format=o:universalTime=true}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message:raw=true}" />
        <attribute name="exception" layout="${exception:format=ToString}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
