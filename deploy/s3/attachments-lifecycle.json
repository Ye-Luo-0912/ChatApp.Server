{
  "Rules": [
    {
      "ID": "delete-unconfirmed-attachment-candidates",
      "Status": "Enabled",
      "Filter": {
        "Tag": {
          "Key": "chatapp-scan-state",
          "Value": "unconfirmed"
        }
      },
      "Expiration": {
        "Days": 1
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    },
    {
      "ID": "delete-quarantined-attachment-candidates",
      "Status": "Enabled",
      "Filter": {
        "Tag": {
          "Key": "chatapp-scan-state",
          "Value": "quarantine"
        }
      },
      "Expiration": {
        "Days": 7
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    }
  ]
}
