{
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": [
      "172.28.0.0/16"
    ]
  },
  "EnableHttpsRedirection": false,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "",
    "SenderName": "ChatApp",
    "Password": "",
    "Host": "",
    "Port": "465"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Garnet": "127.0.0.1:6379,abortConnect=false"
  },
  "DatabasePool": {
    "Role": "All",
    "ApiMaximumPoolSize": 48,
    "WorkerMaximumPoolSize": 16,
    "MinimumPoolSize": 0,
    "ApiCommandTimeoutSeconds": 5,
    "WorkerCommandTimeoutSeconds": 120,
    "AllCommandTimeoutSeconds": 15,
    "MigrationCommandTimeoutSeconds": 120,
    "UseMigrationTimeout": false
  },
  "GarnetCache": {
    "KeyPrefix": "cache:"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "ChatApp",
    "Audience": "ChatApp",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenLength": 32,
    "RefreshTokenExpirationDays": 3,
    "AuthFenceL1CacheMaxEntries": 10000,
    "AuthFenceL1CacheTtlMilliseconds": 1000,
    "AuthFenceDistributedTtlSeconds": 60,
    "MaxActiveSessionsPerUser": 10,
    "SessionChurnCleanupBatchSize": 10
  },
  "Security": {
    "SecretEncryptionKey": "",
    "KeyVersion": 1,
    "PreviousSecretEncryptionKey": "",
    "PreviousKeyVersion": null
  },
  "GeoLocation": {
    "BaseUrl": "https://ip-api.com/",
    "LocalDatabasePath": "",
    "AllowExternalFallback": false,
    "MaxLocalEntries": 250000
  },
  "LoginRisk": {
    "Enabled": true,
    "RuleVersion": 1
  },
  "RealtimeGateway": {
    "Host": "127.0.0.1",
    "Port": 8888,
    "Name": "ChatApp.TcpGateway"
  },
  "AvatarStorage": {
    "Provider": "Local",
    "MaxBytes": 2097152,
    "LocalRootPath": "App_Data/avatars",
    "PublicBaseUrl": "/static/avatars",
    "TicketMinutes": 15,
    "ReencodeMaxConcurrency": 2,
    "ReencodeAcquireTimeoutMilliseconds": 5000,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "AttachmentStorage": {
    "Provider": "Local",
    "MaxBytes": 26214400,
    "MaxUnconfirmedObjectsPerUser": 20,
    "MaxStorageBytesPerUser": 5368709120,
    "LocalRootPath": "App_Data/attachments",
    "PublicBaseUrl": "/static/attachments",
    "UsePublicStatic": false,
    "TicketMinutes": 15,
    "SignedDownloadMinutes": 5,
    "DownloadTicketMinutes": 2,
    "ScannerProvider": "DenyList",
    "ClamAvPort": 3310,
    "ClamAvTimeoutMilliseconds": 30000,
    "ArchiveMaxEntries": 10000,
    "ArchiveMaxUncompressedBytes": 262144000,
    "ArchiveMaxPathDepth": 8,
    "ArchiveMaxNestingDepth": 3,
    "MaxDeleteAttempts": 20,
    "DeleteBackoffSeconds": 30,
    "DeleteBatchSize": 50,
    "MaxScanAttempts": 10,
    "ScanBackoffSeconds": 15,
    "ScanBatchSize": 20,
    "ScanAuditRetentionDays": 90,
    "ScanStagingMaxBytes": 104857600,
    "ScanMaxConcurrentBytes": 52428800,
    "ScanStagingRoot": "/tmp/chatapp-scan",
    "TmpfsSizeBytes": 134217728,
    "StuckScanningMinutes": 30,
    "OpsHighDeleteAttemptThreshold": 5,
    "OpsSampleLimit": 20,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf",
      "audio/mpeg",
      "audio/ogg",
      "video/mp4",
      "application/octet-stream"
    ]
  },
  "NotificationOutbox": {
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "BacklogSampleSeconds": 30
  },
  "WorkerConcurrency": {
    "GlobalMaxConcurrency": 16,
    "NotificationDispatch": 4,
    "EmailDispatch": 4,
    "AttachmentScan": 2,
    "AttachmentProjection": 4,
    "AttachmentConfirm": 2,
    "AttachmentBlobDelete": 2,
    "AccountDeletion": 1,
    "AccountDeletionMaxAttempts": 5,
    "ModerationRevocation": 2,
    "DataExport": 2,
    "SecurityAudit": 1,
    "SecurityRevocation": 2,
    "LoginRiskAnalysis": 2
  },
  "JobRetention": {
    "PollIntervalSeconds": 300,
    "BatchSize": 500,
    "ScanJobRetentionDays": 7,
    "ScanProjectionRetentionDays": 7,
    "ScanAuditRetentionDays": 90,
    "AttachmentConfirmSagaRetentionDays": 7,
    "AttachmentBlobDeleteRetentionDays": 30,
    "LoginAuditRetentionDays": 90,
    "LoginRiskRetentionDays": 30
  },
  "RuntimeHealthMetrics": {
    "RedisPingEnabled": true,
    "RedisPingIntervalSeconds": 30
  },
  "PasswordHashing": {
    "MaxConcurrentOperations": 4,
    "AcquireTimeoutMilliseconds": 200
  },
  "TrustedDevices": {
    "MaxDevicesPerUser": 10
  },
  "MessageEvidence": {
    "RealtimeConnectionString": "",
    "Schema": "realtime",
    "TimeoutMilliseconds": 2000,
    "CacheSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "DataExport": {
    "LocalRootPath": "App_Data/exports",
    "JobTtlHours": 24,
    "LeaseSeconds": 120,
    "PollIntervalMilliseconds": 2000,
    "EncryptAtRest": true,
    "IncludeChatContent": true,
    "ChatExportPageSize": 200,
    "ChatExportMaxMessages": 200000,
    "RealtimeConnectionString": ""
  },
  "AccountCleanupSaga": {
    "PendingTimeoutHours": 72,
    "StalePollIntervalMinutes": 30,
    "MaxMissingSagaDeliveries": 5,
    "MissingSagaNakDelaySeconds": 5
  },
  "RealtimeIntegration": {
    // Url 为空时不注册 IRealtimeMessageBus：AccountCleanupSagaWorker 跳过 NATS 消费，
    // AttachmentBlobsPurge 不会入队；附件 blob GC 仍依赖账号注销本地墓碑。
    "Url": "",
    "ClientName": "chatapp-server",
    "AccountCleanupSubject": "chat.realtime-events.account-deleted",
    "AccountCleanupConsumerName": "chatapp-server-account-cleanup-saga"
  },
  "Profile": {
    "UserNameCooldownDays": 30,
    "UserNameMinLength": 3,
    "UserNameMaxLength": 32
  },
  "RateLimiting": {
    "AuthLoginPermitLimit": 10,
    "AuthLoginWindowSeconds": 60,
    "AuthRegisterPermitLimit": 5,
    "AuthRegisterWindowSeconds": 60,
    "AuthRefreshPermitLimit": 30,
    "AuthRefreshWindowSeconds": 60,
    "AuthEmailPermitLimit": 5,
    "AuthEmailWindowSeconds": 60,
    "UserEmailChangePermitLimit": 3,
    "UserEmailChangeWindowSeconds": 900,
    "UserSensitivePermitLimit": 10,
    "UserSensitiveWindowSeconds": 900,
    "FailOpenWhenRedisUnavailable": false,
    "ClusterShardCount": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "ZLoggerConsoleLoggerProvider": {
      "LogLevel": {
        "Default": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
