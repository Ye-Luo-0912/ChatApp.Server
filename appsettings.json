{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "",
    "SenderName": "ChatApp",
    "Password": "",
    "Host": "",
    "Port": "465"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Garnet": "127.0.0.1:6379,abortConnect=false"
  },
  "GarnetCache": {
    "KeyPrefix": "cache:",
    "DefaultSlidingExpiration": "00:30:00",
    "ExpirationJitterPercent": 0.05,
    "LockTimeout": "00:00:10",
    "DefaultLockExpiry": "00:00:05",
    "NullValueExpiration": "00:05:00"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "ChatApp",
    "Audience": "ChatApp",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenLength": 32,
    "RefreshTokenExpirationDays": 3
  },
  "RealtimeGateway": {
    "Host": "127.0.0.1",
    "Port": 8888,
    "Name": "ChatApp.TcpGateway"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "ZLoggerConsoleLoggerProvider": {
      "LogLevel": {
        "Default": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
