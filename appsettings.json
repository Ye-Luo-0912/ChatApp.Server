{
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": [
      "172.28.0.0/16"
    ]
  },
  "EnableHttpsRedirection": false,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "",
    "SenderName": "ChatApp",
    "Password": "",
    "Host": "",
    "Port": "465"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Garnet": "127.0.0.1:6379,abortConnect=false"
  },
  "GarnetCache": {
    "KeyPrefix": "cache:",
    "DefaultSlidingExpiration": "00:30:00",
    "ExpirationJitterPercent": 0.05,
    "LockTimeout": "00:00:10",
    "DefaultLockExpiry": "00:00:05",
    "NullValueExpiration": "00:05:00"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "ChatApp",
    "Audience": "ChatApp",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenLength": 32,
    "RefreshTokenExpirationDays": 3
  },
  "Security": {
    "SecretEncryptionKey": "",
    "KeyVersion": 1,
    "PreviousSecretEncryptionKey": "",
    "PreviousKeyVersion": null
  },
  "RealtimeGateway": {
    "Host": "127.0.0.1",
    "Port": 8888,
    "Name": "ChatApp.TcpGateway"
  },
  "AvatarStorage": {
    "Provider": "Local",
    "MaxBytes": 2097152,
    "LocalRootPath": "App_Data/avatars",
    "PublicBaseUrl": "/static/avatars",
    "TicketMinutes": 15,
    "ReencodeMaxConcurrency": 2,
    "ReencodeAcquireTimeoutMilliseconds": 5000,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "AttachmentStorage": {
    "Provider": "Local",
    "MaxBytes": 26214400,
    "LocalRootPath": "App_Data/attachments",
    "PublicBaseUrl": "/static/attachments",
    "UsePublicStatic": false,
    "TicketMinutes": 15,
    "SignedDownloadMinutes": 5,
    "MaxDeleteAttempts": 20,
    "DeleteBackoffSeconds": 30,
    "DeleteBatchSize": 50,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf",
      "audio/mpeg",
      "audio/ogg",
      "video/mp4",
      "application/octet-stream"
    ]
  },
  "NotificationOutbox": {
    "BatchSize": 20,
    "MaxConcurrency": 4,
    "PollIntervalSeconds": 5,
    "BacklogSampleSeconds": 30
  },
  "PasswordHashing": {
    "MaxConcurrentOperations": 4,
    "AcquireTimeoutMilliseconds": 200
  },
  "TrustedDevices": {
    "MaxDevicesPerUser": 10
  },
  "MessageEvidence": {
    "RealtimeConnectionString": "",
    "Schema": "realtime",
    "TimeoutMilliseconds": 2000,
    "CacheSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "DataExport": {
    "JobTtlHours": 24,
    "LeaseSeconds": 120,
    "PollIntervalMilliseconds": 2000,
    "EncryptAtRest": true,
    "IncludeChatContent": true,
    "ChatExportPageSize": 200,
    "ChatExportMaxMessages": 200000,
    "RealtimeConnectionString": ""
  },
  "AccountCleanupSaga": {
    "PendingTimeoutHours": 72,
    "StalePollIntervalMinutes": 30,
    "MaxMissingSagaDeliveries": 5,
    "MissingSagaNakDelaySeconds": 5
  },
  "RealtimeIntegration": {
    // Url 为空时不注册 IRealtimeMessageBus：AccountCleanupSagaWorker 跳过 NATS 消费，
    // AttachmentBlobsPurge 不会入队；附件 blob GC 仍依赖账号注销本地墓碑。
    "Url": "",
    "ClientName": "chatapp-server",
    "AccountCleanupSubject": "chat.realtime-events.account-deleted",
    "AccountCleanupConsumerName": "chatapp-server-account-cleanup-saga"
  },
  "Profile": {
    "UserNameCooldownDays": 30,
    "UserNameMinLength": 3,
    "UserNameMaxLength": 32
  },
  "RateLimiting": {
    "AuthLoginPermitLimit": 10,
    "AuthLoginWindowSeconds": 60,
    "AuthRefreshPermitLimit": 30,
    "AuthRefreshWindowSeconds": 60,
    "AuthEmailPermitLimit": 5,
    "AuthEmailWindowSeconds": 60,
    "UserEmailChangePermitLimit": 3,
    "UserEmailChangeWindowSeconds": 900,
    "UserSensitivePermitLimit": 10,
    "UserSensitiveWindowSeconds": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "ZLoggerConsoleLoggerProvider": {
      "LogLevel": {
        "Default": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
