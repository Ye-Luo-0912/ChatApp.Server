{
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": [
      "172.28.0.0/16"
    ]
  },
  "EnableHttpsRedirection": false,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "",
    "SenderName": "ChatApp",
    "Password": "",
    "Host": "",
    "Port": "465"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Garnet": "127.0.0.1:6379,abortConnect=false"
  },
  "GarnetCache": {
    "KeyPrefix": "cache:",
    "DefaultSlidingExpiration": "00:30:00",
    "ExpirationJitterPercent": 0.05,
    "LockTimeout": "00:00:10",
    "DefaultLockExpiry": "00:00:05",
    "NullValueExpiration": "00:05:00"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "ChatApp",
    "Audience": "ChatApp",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenLength": 32,
    "RefreshTokenExpirationDays": 3
  },
  "Security": {
    "SecretEncryptionKey": "",
    "KeyVersion": 1,
    "PreviousSecretEncryptionKey": "",
    "PreviousKeyVersion": null
  },
  "RealtimeGateway": {
    "Host": "127.0.0.1",
    "Port": 8888,
    "Name": "ChatApp.TcpGateway"
  },
  "AvatarStorage": {
    "Provider": "Local",
    "MaxBytes": 2097152,
    "LocalRootPath": "App_Data/avatars",
    "PublicBaseUrl": "/static/avatars",
    "TicketMinutes": 15,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Profile": {
    "UserNameCooldownDays": 30,
    "UserNameMinLength": 3,
    "UserNameMaxLength": 32
  },
  "RateLimiting": {
    "AuthLoginPermitLimit": 10,
    "AuthLoginWindowSeconds": 60,
    "AuthRefreshPermitLimit": 30,
    "AuthRefreshWindowSeconds": 60,
    "AuthEmailPermitLimit": 5,
    "AuthEmailWindowSeconds": 60,
    "UserEmailChangePermitLimit": 3,
    "UserEmailChangeWindowSeconds": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "ZLoggerConsoleLoggerProvider": {
      "LogLevel": {
        "Default": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
