using BenchmarkDotNet.Attributes;
using Core.Services;
using ChatApp.Core.Interfaces;
using Infrastructure.Identity;
using Infrastructure.Exceptions;
using Microsoft.AspNetCore.Identity;
using Microsoft.Extensions.Logging;
using Moq;
using Microsoft.VSDiagnostics;

namespace Core.Benchmarks;
[SimpleJob(warmupCount: 3, targetCount: 5)]
[CPUUsageDiagnoser]
public class UserManageServicesBenchmark
{
    private UserManageServices _service;
    private Mock<UserManager<ApplicationUser>> _userManager;
    private Mock<IJwtTokenService> _tokenService;
    private Mock<ILogger<UserManageServices>> _logger;
    private ApplicationUser _testUser;
    [GlobalSetup]
    public void Setup()
    {
        _userManager = new Mock<UserManager<ApplicationUser>>(new Mock<IUserStore<ApplicationUser>>().Object, null, null, null, null, null, null, null, null);
        _tokenService = new Mock<IJwtTokenService>();
        _logger = new Mock<ILogger<UserManageServices>>();
        _testUser = new ApplicationUser
        {
            Id = Guid.NewGuid(),
            UserName = "testuser"
        };
        // Setup mocks for successful login
        _userManager.Setup(x => x.FindByNameAsync("testuser")).ReturnsAsync(_testUser);
        _userManager.Setup(x => x.CheckPasswordAsync(_testUser, "password")).ReturnsAsync(true);
        _userManager.Setup(x => x.IsLockedOutAsync(_testUser)).ReturnsAsync(false);
        _userManager.Setup(x => x.GetRolesAsync(_testUser)).ReturnsAsync(new List<string> { "User" });
        _tokenService.Setup(x => x.GenerateAccessToken(_testUser, It.IsAny<IList<string>>())).Returns("access_token");
        _tokenService.Setup(x => x.GenerateRefreshToken()).Returns("refresh_token");
        _tokenService.Setup(x => x.StoreRefreshTokenAsync(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<TimeSpan>())).ReturnsAsync(true);
        _service = new UserManageServices(_userManager.Object, _tokenService.Object, _logger.Object);
    }

    [Benchmark]
    public async Task LoginAsync_SuccessfulLogin()
    {
        await _service.LoginAsync("testuser", "password");
    }

    [Benchmark]
    public async Task LoginAsync_InvalidUser()
    {
        await _service.LoginAsync("nonexistent", "password");
    }

    [Benchmark]
    public async Task FindByUserNameAsync()
    {
        await _service.FindByUserNameAsync("testuser");
    }
}