# docker-compose / 本地开发凭据（复制为 .env 后填写，勿提交真实生产值）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ChatAppDatabase

# 反代：宿主机 API 端口（dotnet run 默认或 launchSettings）
CHATAPP_UPSTREAM_PORT=5280
CHATAPP_PROXY_PORT=8080
ASPNETCORE_URLS=http://0.0.0.0:5280
EnableHttpsRedirection=false

# Compose 内网：仅信任反代网段（见 docker-compose networks.chatapp_net）
# ForwardedHeaders__KnownNetworks__0=172.28.0.0/16
# ForwardedHeaders__KnownProxies__0=127.0.0.1

# 本地开发映射端口（仅环回）:
# docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up -d

# ASP.NET / 迁移
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ChatAppDatabase;Username=postgres;Password=change-me;...
# ConnectionStrings__Garnet=127.0.0.1:6379,abortConnect=false
EmailSettings__SenderEmail=sender@example.com
EmailSettings__Password=replace-with-smtp-app-password
EmailSettings__Host=smtp.example.com
# JwtSettings__Secret=use-a-long-random-secret
# Security__SecretEncryptionKey=use-an-independent-long-random-secret
# ForwardedHeaders__KnownProxies__0=127.0.0.1
# ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# 生产建议：JWT / SMTP / DB 密码仅通过编排 Secrets 或密文注入，勿写入镜像。

# 生产环境强制使用共享 S3 对象存储；凭据使用 IAM role/default credential chain 注入。
# DataExport__Provider=S3
# DataExport__EncryptAtRest=false
# DataExport__S3Bucket=chatapp-exports
# DataExport__S3Region=us-east-1
# DataExport__S3Endpoint=
# DataExport__S3ForcePathStyle=false
# DataExport__S3SseMode=SSE-S3
# DataExport__S3KmsKeyId=

# 附件生产环境：共享对象存储 + 恶意软件扫描；SDK 使用 IAM/default credential chain。
# AttachmentStorage__Provider=S3
# AttachmentStorage__S3Bucket=chatapp-attachments
# AttachmentStorage__S3Region=us-east-1
# AttachmentStorage__S3SseMode=SSE-S3
# AttachmentStorage__S3KmsKeyId=
# AttachmentStorage__MaxUnconfirmedObjectsPerUser=20
# AttachmentStorage__MaxStorageBytesPerUser=5368709120
# AttachmentStorage__ScannerProvider=ClamAV
# AttachmentStorage__ClamAvHost=clamav
# AttachmentStorage__ClamAvPort=3310
# TLS：使用 deploy/nginx/chatapp-tls.conf.template + 证书挂载，在边缘终止 HTTPS。
